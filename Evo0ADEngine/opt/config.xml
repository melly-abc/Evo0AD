<Config>
		<Genetic>		
			<!-- 初期化フェーズ -->
			<Logic type="Init">
				<Class>jp.co.evo.phase.InitPhase</Class>
			</Logic>
			<!-- 選択（淘汰）フェーズ -->
			<Logic type="Selection" incidence="0.0">
				<Class>jp.co.evo.phase.SelectionPhase</Class>
			</Logic>
			<!-- 交叉フェーズ -->
			<Logic type="CrossOver" incidence="0.0">
				<Class>jp.co.evo.phase.CrossOverPhase</Class>
			</Logic>
			<!-- 突然変異フェーズ -->
			<Logic type="Mutation" incidence="0.0">
				<Class>jp.co.evo.phase.MutationPhase</Class>
			</Logic>
			<!-- 終了フェーズ -->
            <Logic type="Finalize">
                <Class>jp.co.evo.phase.FinalizePhase</Class>
            </Logic>
			<!-- 個体情報 -->
			<Individual num = "5">
			    <Class>jp.co.evo.individual.EvoIndividual</Class>
			    <Gene>
			    <Class>jp.co.evo.individual.gene.EvoGene</Class>
			    </Gene>
			</Individual>
		</Genetic>
		<System>
		    <!-- メッセージ定義ファイル -->
            <Message>
                <File>opt/messages.properties</File>
            </Message>
            <!-- ログ定義ファイル -->
            <Log>
                <File>opt/logback.xml</File>
            </Log>
		</System>
</Config>